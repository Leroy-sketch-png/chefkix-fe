# This file documents the environment variables required by the application.
# Create a .env.local file for your local development environment.

NEXT_PUBLIC_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only AI proxy configuration. Never prefix the shared key with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=CHANGE_ME_SHARED_AI_SERVICE_KEY
# Independent HMAC secret used to pseudonymize authenticated callers for AI quotas.
# Must match the AI service and be distinct from every other application secret.
AI_RATE_LIMIT_SUBJECT_SECRET=CHANGE_ME_RATE_LIMIT_SUBJECT_SECRET_32_CHARS_MINIMUM
# Stable pseudonymization key: keep unchanged across routine signing-key rotations.
# For the first v67 -> v68 rollout, set this to the former subject-signing secret,
# then rotate AI_RATE_LIMIT_SUBJECT_SECRET and place the former value in PREVIOUS on AI.
AI_RATE_LIMIT_PSEUDONYM_SECRET=CHANGE_ME_RATE_LIMIT_PSEUDONYM_SECRET_32_CHARS_MINIMUM

# WebRTC relay. A public TURN URL is required for separate-network demo devices.
NEXT_PUBLIC_TURN_URL=turn:localhost:3478?transport=udp
NEXT_PUBLIC_TURN_USERNAME=chefkix
NEXT_PUBLIC_TURN_CREDENTIAL=CHANGE_ME
